<?xml version="1.0" encoding="UTF-8"?>
<!-- Registers the two euspell linguistic services with LibreOffice's linguistic
     ServiceManager for the private locale en-x-euspell. The framework also
     enumerates the passively-registered UNO services and calls getLocales(), so
     this file mainly fixes their availability/priority for the euspell locale.
     The tagged-locale node key (qlt-US-en-x-euspell) may need adjustment per
     LibreOffice version — verify on-device (see libreoffice/README.md). -->
<oor:component-data
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Linguistic"
    oor:package="org.openoffice.Office">
  <node oor:name="ServiceManager">
    <node oor:name="SpellCheckerList">
      <node oor:name="qlt-US-en-x-euspell" oor:op="fuse">
        <prop oor:name="qlt-US-en-x-euspell" oor:op="fuse" oor:type="oor:string-list">
          <value>org.euspell.linguistic.SpellChecker</value>
        </prop>
      </node>
    </node>
    <node oor:name="GrammarCheckerList">
      <node oor:name="qlt-US-en-x-euspell" oor:op="fuse">
        <prop oor:name="qlt-US-en-x-euspell" oor:op="fuse" oor:type="oor:string-list">
          <value>org.euspell.linguistic.Proofreader</value>
        </prop>
      </node>
    </node>
  </node>
</oor:component-data>
