# Large generated disambiguation corpora (regenerable from Euspell/all_VVZ_f.txt)
disambig/_corpus_*.txt

# LibreOffice extension data: copied/exported from the lexicon by `npm run gen:lo`
libreoffice/euspell/data/

# Apps Script dictionary data (~5 MB), generated by `npm run gen:gas`
apps-script/euspell-data.gs

# Word add-in generated engine/data/icons, by `npm run gen:word`
word-addin/src/euspell-engine.js
word-addin/src/euspell-data.js
word-addin/assets/

# Apple Pages JXA script (~5 MB, data+engine+glue), generated by `npm run gen:pages`
pages/euspell-pages.js

# Local Claude Code state: an auto-accumulated allowlist full of absolute paths
# from individual sessions, so it is personal to one machine, not project config.
.claude/
