dist/
.next/
node_modules/

# Store build staging + packaged zips (regenerable via `npm run build:chrome`
# and `npm run build:firefox`)
build/chrome/
build/euspell-chrome.zip
build/firefox/
build/euspell-firefox.zip
web-ext-artifacts/

# Safari extension: the Xcode project in safari/ is committed, but the staged
# web-extension payload is regenerable (via `npm run build:safari`) and stays out
# of git, exactly like dist/ at the repo root. Also ignore Xcode's per-user state
# and any local build output.
safari/Euspell Extension/Resources/
safari/build/
safari/**/xcuserdata/
safari/**/*.xcuserstate
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.log
*.map

# Large generated disambiguation corpora (regenerable from Euspell/all_VVZ_f.txt)
disambig/_corpus_*.txt

# LibreOffice extension data: copied/exported from the lexicon by `npm run gen:lo`
libreoffice/euspell/data/

# Apps Script dictionary data (~5 MB), generated by `npm run gen:gas`
apps-script/euspell-data.gs

# Apple Pages JXA script (~5 MB, data+engine+glue), generated by `npm run gen:pages`
pages/euspell-pages.js

# Word add-in generated engine/data/icons, by `npm run gen:word`
word-addin/src/euspell-engine.js
word-addin/src/euspell-data.js
word-addin/assets/

# Local Claude Code state: an auto-accumulated allowlist full of absolute paths
# from individual sessions, so it is personal to one machine, not project config.
.claude/

# Internal working notes: kept locally, not published.
# They are inventories of gaps, unsent drafts and store-dashboard answers --
# launch-readiness.md opens by saying it must never reach a journalist.
docs/launch-readiness.md
docs/press-release.md
docs/paper-publishing.md
docs/chrome-submission.md
