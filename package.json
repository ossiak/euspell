{
  "name": "euspell",
  "version": "0.3.0",
  "description": "Chrome extension for euspell English spelling reform",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "build": "npm run build:lexicon && npm run build:pdfjs && npm run build:ext",
    "build:lexicon": "node build/compile-lexicon.js",
    "build:pdfjs": "node build/copy-pdfjs.js",
    "build:ext": "rollup -c",
    "build:pdf:mobile": "rollup -c rollup.pdf.mobile.config.js",
    "build:chrome": "npm run build && node build/gen-chrome.js",
    "build:firefox": "npm run build && node build/gen-firefox.js",
    "lint:firefox": "web-ext lint --source-dir build/firefox",
    "build:safari": "npm run build && node build/gen-safari.js",
    "run:firefox": "web-ext run --source-dir build/firefox",
    "gen:svm": "python build/gen-vvz-svm.py",
    "gen:corpus:vv0": "node build/gen-corpus-vv0.mjs",
    "gen:corpus:clitic-s": "node build/gen-corpus-clitic-s.mjs",
    "gen:vv0-prior": "node build/gen-vv0-prior.mjs",
    "eval:vv0": "node build/rule-vv0.mjs",
    "eval:clitic-s": "node build/rule-clitic-s.mjs",
    "gen:claws7-tagset": "node build/gen-claws7-tagset.mjs",
    "gen:popup-encodings": "node build/gen-popup-encodings.mjs",
    "gen:pls": "node build/gen-pls.js",
    "gen:pls:contractions": "python build/gen-pls-contractions.py",
    "gen:pos": "node build/gen-pos-lexicon.js",
    "gen:harper": "node build/gen-harper-metadata.js",
    "gen:icons": "node build/gen-icons.js",
    "gen:wordlist": "node build/gen-wordlist.js",
    "gen:oxt": "npm run gen:wordlist && node build/gen-oxt.js",
    "gen:lo": "node build/gen-lo.js",
    "gen:lo:fixtures": "node build/gen-lo-fixtures.mjs",
    "gen:lo:oxt": "npm run gen:lo && node build/gen-lo-oxt.js",
    "test:lo": "node build/gen-lo-fixtures.mjs && python libreoffice/tests/test_engine.py",
    "gen:gas": "npm run gen:lo && node build/gen-gas.js",
    "gen:pages": "npm run gen:gas && node build/gen-pages.js",
    "test:gas": "node build/gen-lo-fixtures.mjs && node build/test-gas.mjs",
    "gen:word": "npm run gen:lo && node build/gen-word.js",
    "gen:word-dict": "node build/gen-word-dict.js",
    "gen:word-exclude": "node build/gen-word-exclude.js",
    "word:serve": "node word-addin/server.js",
    "gen:diatones": "node build/gen-diatones.js",
    "watch": "rollup -c --watch"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "adm-zip": "^0.5.17",
    "csv-parse": "^5.0.0",
    "eslint": "^9.39.5",
    "pdfjs-dist": "^6.0.227",
    "rollup": "^4.0.0",
    "sharp": "^0.33.5",
    "web-ext": "^10.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ossiak/euspell.git"
  },
  "license": "GPL-3.0-or-later",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true
  }
}
