{
  "name": "euspell",
  "version": "0.1.0",
  "description": "Chrome extension for euspell English spelling reform",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "npm run build:lexicon && npm run build:pdfjs && npm run build:ext",
    "build:lexicon": "node build/compile-lexicon.js",
    "build:pdfjs": "node build/copy-pdfjs.js",
    "build:ext": "rollup -c",
    "gen:svm": "python build/gen-vvz-svm.py",
    "gen:pls": "node build/gen-pls.js",
    "gen:icons": "node build/gen-icons.js",
    "gen:wordlist": "node build/gen-wordlist.js",
    "gen:oxt": "npm run gen:wordlist && node build/gen-oxt.js",
    "gen:lo": "node build/gen-lo.js",
    "gen:lo:fixtures": "node build/gen-lo-fixtures.mjs",
    "gen:lo:oxt": "npm run gen:lo && node build/gen-lo-oxt.js",
    "test:lo": "node build/gen-lo-fixtures.mjs && python libreoffice/tests/test_engine.py",
    "gen:gas": "npm run gen:lo && node build/gen-gas.js",
    "test:gas": "node build/gen-lo-fixtures.mjs && node build/test-gas.mjs",
    "gen:diatones": "node build/gen-diatones.js",
    "watch": "rollup -c --watch"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "adm-zip": "^0.5.17",
    "csv-parse": "^5.0.0",
    "pdfjs-dist": "^6.0.227",
    "rollup": "^4.0.0",
    "sharp": "^0.33.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ossiak/euspell.git"
  },
  "license": "GPL-3.0-or-later"
}
