SET UTF-8

# Characters to try when generating suggestions (English letter frequency order)
TRY esianrtolcdugmphbyfvkwzxjq'ESIANRTOLCDUGMPHBYFVKWZXJQ

# Allow apostrophe inside words (contractions: 'bout, 'cause, it's etc.)
WORDCHARS '

